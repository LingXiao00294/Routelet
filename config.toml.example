# 手工配置参考；routelet 首次运行会自动创建不含 Provider 和模型的空配置。
# API 与 Dashboard 共用下方监听地址和端口。
# Provider、模型、密钥变量与 .example 地址均为占位符，请替换为实际值。
# type 是协议标识，需保留示例值以使用当前支持的 Messages API。
[server]
host = "127.0.0.1"
port = 9456
log_level = "info"
log_file = "logs/routelet.log"
log_max_bytes = 10000000
log_backup_count = 5

[router]
failure_threshold = 5
recovery_timeout = 600
mode = "sticky"   # 自动故障转移关闭：仅调用 pinned_model，Provider 错误状态码/正文原样返回；"failover" 开启故障转移

[providers.provider-a]
type = "anthropic"
api_key = "${PROVIDER_A_API_KEY}"
base_url = "https://api.provider-a.example"
timeout_seconds = 120
# 本地限流（0 = 不限制，保持旧行为）
# max_concurrent = 0
# max_queue = 0
# queue_wait_timeout = 30
# rate_limit_cooldown = 30

[providers.provider-a.models."model-a-pro"]
# 可选，单位 USD / 1M Token；省略时快照为 NULL，显式 0 时快照保留 0
# 两种情况在费用计算时都按 0，但历史记录可区分
# input_price_per_million = 0
# output_price_per_million = 0
# cache_read_price_per_million = 0
# cache_write_price_per_million = 0

[providers.provider-b]
type = "anthropic"
api_key = "${PROVIDER_B_API_KEY}"
base_url = "https://api.provider-b.example"
timeout_seconds = 120

[providers.provider-b.models."model-b-pro"]

[providers.provider-b.models."model-b-fast"]

[providers."provider-c"]
type = "anthropic"
api_key = "${PROVIDER_C_API_KEY}"
base_url = "https://api.provider-c.example"
timeout_seconds = 120

[providers."provider-c".models."model-c-pro"]

[providers."provider-c".models."model-c-fast"]

[models.reasoning-route]
pinned_model = { provider = "provider-c", model = "model-c-pro" }
models = [
  { provider = "provider-c", model = "model-c-pro" },
  { provider = "provider-b", model = "model-b-pro" },
  { provider = "provider-a", model = "model-a-pro" },
]

[models.coding-route]
pinned_model = { provider = "provider-b", model = "model-b-fast" }
models = [
  { provider = "provider-b", model = "model-b-fast" },
  { provider = "provider-c", model = "model-c-fast" },
]

[models.fast-route]
pinned_model = { provider = "provider-b", model = "model-b-fast" }
models = [
  { provider = "provider-b", model = "model-b-fast" },
  { provider = "provider-c", model = "model-c-fast" },
]
